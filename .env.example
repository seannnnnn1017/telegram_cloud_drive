BOT_TOKEN=your_bot_token_here
CHAT_ID=-100your_channel_id_here
VAULT_DB_PATH=vault.db
# Optional: point this at a self-hosted Telegram Local Bot API server.
# Example: TELEGRAM_API_BASE_URL=http://127.0.0.1:8081
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Optional: allow uploads sent directly to the bot chat to enter the vault.
TELEGRAM_INGEST_UPDATES=true
# Optional: comma-separated Telegram chat IDs allowed to ingest files.
# Leave empty to accept files from any chat that can message the bot.
TELEGRAM_INGEST_ALLOWED_CHAT_IDS=
